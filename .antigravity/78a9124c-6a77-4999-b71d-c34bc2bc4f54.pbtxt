      target_content: "const AboutSection = () => {\n  return (\n    <section id=\"about\" className=\"py-24 bg-white px-6 overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\">\n          <div className=\"relative\">\n            <motion.div \n              initial={{ opacity: 0, scale: 0.9 }}\n              whileInView={{ opacity: 1, scale: 1 }}\n              viewport={{ once: true }}\n              className=\"relative z-10 aspect-square rounded-[60px] overflow-hidden shadow-2xl shadow-blue-100\"\n            >\n              <img \n                src=\"https://images.unsplash.com/photo-1503387762-592f61a52b67?q=80&w=2062&auto=format&fit=crop\" \n                alt=\"Architecture\"\n                className=\"w-full h-full object-cover\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </motion.div>\n            <div className=\"absolute -bottom-10 -right-10 w-64 h-64 bg-blue-50 rounded-[40px] -z-0 hidden md:block\" />\n            <motion.div \n              initial={{ opacity: 0, x: 50 }}\n              whileInView={{ opacity: 1, x: 0 }}\n              viewport={{ once: true }}\n              style={{ paddingLeft: \'79px\' }}\n              className=\"absolute -top-10 -left-10 bg-blue-600 text-white p-8 rounded-[40px] z-20 hidden md:block shadow-xl shadow-blue-600/20\"\n            >\n              <p className=\"text-3xl font-black tracking-tighter\">15+</p>\n              <p className=\"text-[10px] uppercase tracking-widest font-bold opacity-60\">Years of Legacy</p>\n            </motion.div>\n          </div>\n\n          <motion.div \n            initial={{ opacity: 0, x: 30 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true }}\n          >\n            <h2 className=\"text-blue-400 text-sm font-bold tracking-[0.2em] uppercase mb-4\">Our Essence</h2>\n            <h3 className=\"text-4xl md:text-6xl font-bold tracking-tight text-slate-900 leading-tight mb-8 font-sans\">\n              Building the <span className=\"text-blue-200 italic font-serif\">Incredible</span> with Absolute Precision.\n            </h3>\n            <p className=\"text-slate-500 text-lg leading-relaxed mb-8 font-light\">\n              At Sanchar Infratech, we don\'t just build structures; we create landmarks that stand the test of time. Our philosophy integrates futuristic architectural trends with robust structural engineering.\n            </p>\n            <div className=\"space-y-6 mb-10\">\n              {[\n                { title: \'Mission\', desc: \'To redefine urban landscapes through innovative and sustainable infrastructure.\' },\n                { title: \'Vision\', desc: \'To be the global benchmark for excellence in multi-disciplinary infratech.\' }\n              ].map(item => (\n                <div key={item.title}>\n                  <p className=\"text-xs font-black uppercase tracking-[0.2em] text-blue-600 mb-1\">{item.title}</p>\n                  <p className=\"text-slate-500 text-sm font-light\">{item.desc}</p>\n                </div>\n              ))}\n            </div>\n            <button className=\"flex items-center gap-2 text-blue-600 font-bold uppercase tracking-widest text-xs border-b-2 border-blue-600 pb-1 hover:gap-4 transition-all hover:text-blue-700 hover:border-blue-700\">\n              Our Detailed Profile <ArrowRight size={14} />\n            </button>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n};"
