className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n          </a>\n          <motion.div \n            animate={{ y: [0, 10, 0] }}\n            transition={{ repeat: Infinity, duration: 2 }}\n            className=\"text-white/30\"\n          >\n            <ChevronDown className=\"w-6 h-6\" />\n          </motion.div>\n        </motion.div>\n      </div>\n    </section>\n  );\n};\n\nconst StatsSection = () => {\n  return (\n    <section className=\"py-20 bg-white border-b border-zinc-100\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-12\">\n          {STATS.map((stat, idx) => (\n            <motion.div \n              key={stat.label}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              transition={{ delay: idx * 0.1 }}\n              viewport={{ once: true }}\n              className=\"text-center lg:text-left\"\n            >\n              <div className=\"flex flex-col lg:flex-row items-center gap-4\">\n                <div className=\"w-12 h-12 rounded-full bg-zinc-50 flex items-center justify-center text-zinc-900\">\n                  <stat.icon size={24} />\n                </div>\n                <div>\n                  <p className=\"text-4xl font-extrabold tracking-tighter text-zinc-900\">{stat.value}</p>\n                  <p className=\"text-xs font-bold text-zinc-400 uppercase tracking-widest mt-1\">{stat.label}</p>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst AboutSection = () => {\n  return (\n    <section id=\"about\" className=\"py-24 bg-white px-6 overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\">\n          <div className=\"relative\">\n            <motion.div \n              initial={{ opacity: 0, scale: 0.9 }}\n              whileInView={{ opacity: 1, scale: 1 }}\n              viewport={{ once: true }}\n              className=\"relative z-10 aspect-square rounded-[60px] overflow-hidden\"\n            >\n              <img \n                src=\"https://images.unsplash.com/photo-1503387762-592f61a52b67?q=80&w=2062&auto=format&fit=crop\" \n                alt=\"Architecture\"\n                className=\"w-full h-full object-cover\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </motion.div>\n            <div className=\"absolute -bottom-10 -right-10 w-64 h-64 bg-zinc-100 rounded-[40px] -z-0 hidden md:block\" />\n            <motion.div \n              initial={{ opacity: 0, x: 50 }}\n              whileInView={{ opacity: 1, x: 0 }}\n              viewport={{ once: true }}\n              className=\"absolute -top-10 -left-10 bg-black text-white p-8 rounded-[40px] z-20 hidden md:block\"\n            >\n              <p className=\"text-3xl font-black tracking-tighter\">15+</p>\n              <p className=\"text-[10px] uppercase tracking-widest font-bold opacity-60\">Years of Legacy</p>\n            </motion.div>\n          </div>\n\n          <motion.div \n            initial={{ opacity: 0, x: 30 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true }}\n          >\n            <h2 className=\"text-sm font-bold tracking-[0.2em] uppercase text-zinc-400 mb-4\">Our Essence</h2>\n            <h3 className=\"text-4xl md:text-6xl font-bold tracking-tight text-zinc-900 leading-tight mb-8 font-sans\">\n              Building the <span className=\"text-zinc-300 italic font-serif\">Incredible</span> with Absolute Precision.\n            </h3>\n            <p className=\"text-zinc-500 text-lg leading-relaxed mb-8\">\n              At Sanchar Infratech, we don\'t just build structures; we create landmarks that stand the test of time. Our philosophy integrates futuristic architectural trends with robust structural engineering.\n            </p>\n            <div className=\"space-y-6 mb-10\">\n              {[\n                { title: \'Mission\', desc: \'To redefine urban landscapes through innovative and sustainable infrastructure.\' },\n                { title: \'Vision\', desc: \'To be the global benchmark for excellence in multi-disciplinary infratech.\' }\n              ].map(item => (\n                <div key={item.title}>\n                  <p className=\"text-xs font-black uppercase tracking-[0.2em] text-black mb-1\">{item.title}</p>\n                  <p className=\"text-zinc-500 text-sm\">{item.desc}</p>\n                </div>\n              ))}\n            </div>\n            <button className=\"flex items-center gap-2 text-black font-bold uppercase tracking-widest text-xs border-b-2 border-black pb-1 hover:gap-4 transition-all\">\n              Our Detailed Profile <ArrowRight size={14} />\n            </button>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst ProcessSection = () => {\n  return (\n    <section id=\"process\" className=\"py-24 bg-zinc-50 px-6\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"text-center mb-20\">\n          <h2 className=\"text-sm font-bold tracking-[0.2em] uppercase text-zinc-400 mb-4\">How we work</h2>\n          <h3 className=\"text-4xl md:text-5xl font-bold tracking-tight text-zinc-900\">\n            The Project <span className=\"italic font-serif\">Lifecycle</span>\n          </h3>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\">\n          {PROCESS_STEPS.map((step, idx) => (\n            <motion.div \n              key={step.title}\n              initial={{ opacity: 0, scale: 0.95 }}\n              whileInView={{ opacity: 1, scale: 1 }}\n              transition={{ delay: idx * 0.1 }}\n              viewport={{ once: true }}\n              className=\"relative bg-white p-10 rounded-[40px] border border-zinc-100 hover:shadow-xl hover:shadow-zinc-200/50 transition-all group\"\n            >\n              <div className=\"absolute top-8 right-8 text-6xl font-black text-zinc-50 opacity-0 group-hover:opacity-100 transition-opacity\">\n                0{idx + 1}\n              </div>\n              <div className=\"w-14 h-14 bg-zinc-50 rounded-2xl flex items-center justify-center text-zinc-900 mb-6 group-hover:bg-black group-hover:text-white transition-all\">\n                <step.icon size={28} />\n              </div>\n              <h4 className=\"text-xl font-bold text-zinc-900 mb-3\">{step.title}</h4>\n              <p className=\"text-zinc-500 text-sm leading-relaxed\">{step.desc}</p>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst ValuesSection = () => {\n  return (\n    <section className=\"py-24 bg-white px-6\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-20\">\n          <div>\n             <h2 className=\"text-sm font-bold tracking-[0.2em] uppercase text-zinc-400 mb-4\">Differentiators</h2>\n             <h3 className=\"text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 mb-8 font-sans\">\n              Why Leaders Choose <br /> <span className=\"text-zinc-300 italic font-serif\">Sanchar Infratech.</span>\n            </h3>\n            <p className=\"text-zinc-500 text-lg leading-relaxed mb-10 max-w-lg\">\n              Our commitment to quality and safety is backed by decades of experience and a relentless drive for innovation.\n            </p>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-8\">\n              {VALUES.map((value, idx) => (\n                <div key={value.title} className=\"space-y-3\">\n                  <div className=\"w-10 h-10 rounded-full bg-zinc-100 flex items-center justify-center\">\n                    <value.icon size={18} />\n                  </div>\n                  <h4 className=\"font-bold text-zinc-900 uppercase tracking-widest text-[10px]\">{value.title}</h4>\n                  <p className=\"text-zinc-500 text-xs leading-relaxed\">{value.desc}</p>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-4 translate-y-12\">\n               <div className=\"aspect-[4/5] rounded-[40px] overflow-hidden\">\n                <img src=\"https://images.unsplash.com/photo-1541888946425-d81bb19240f5?q=80&w=2070&auto=format&fit=crop\" className=\"w-full h-full object-cover\" alt=\"Construction\" referrerPolicy=\"no-referrer\" />\n               </div>\n               <div className=\"aspect-square rounded-[40px] overflow-hidden\">\n                <img src=\"https://images.unsplash.com/photo-1531834351307-e83c74624775?q=80&w=1974&auto=format&fit=crop\" className=\"w-full h-full object-cover\" alt=\"Construction\" referrerPolicy=\"no-referrer\" />\n               </div>\n            </div>\n            <div className=\"space-y-4\">\n               <div className=\"aspect-square rounded-[40px] overflow-hidden\">\n                <img src=\"https://images.unsplash.com/photo-1517581177682-a085bb7ffb15?q=80&w=2072&auto=format&fit=crop\" className=\"w-full h-full object-cover\" alt=\"Construction\" referrerPolicy=\"no-referrer\" />\n               </div>\n               <div className=\"aspect-[4/5] rounded-[40px] overflow-hidden\">\n                <img src=\"https://images.unsplash.com/photo-1581092160562-40aa08e78837?q=80&w=2070&auto=format&fit=crop\" className=\"w-full h-full object-cover\" alt=\"Construction\" referrerPolicy=\"no-referrer\" />\n               </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
