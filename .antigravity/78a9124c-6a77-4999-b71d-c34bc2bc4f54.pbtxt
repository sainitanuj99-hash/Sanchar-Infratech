    replacement_chunks {
      target_content: "const Sectors = () => {\n  return (\n    <section id=\"sectors\" className=\"py-24 bg-white px-6\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6\">\n          <div className=\"max-w-xl\">\n            <h2 className=\"text-sm font-bold tracking-[0.2em] uppercase text-blue-400 mb-4\">Core Competencies</h2>\n            <h3 className=\"text-4xl md:text-6xl font-bold tracking-tight text-slate-900 leading-tight\">\n              Crafting infrastructure that shapes <span className=\"text-blue-200 italic font-serif\">future societies.</span>\n            </h3>\n          </div>\n          <p className=\"text-slate-500 max-w-xs text-sm leading-relaxed font-light\">\n            From monumental sports arenas to bespoke residential sanctuaries, we build with precision and purpose.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n          {SECTORS.map((sector, idx) => (\n            <motion.div \n              key={sector.id}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              transition={{ delay: idx * 0.1 }}\n              viewport={{ once: true }}\n              className=\"group relative h-[500px] overflow-hidden rounded-3xl cursor-pointer shadow-xl shadow-blue-50/50\"\n            >\n              <img \n                src={sector.image}\n                alt={sector.title}\n                className=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-900/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity\" />\n              \n              <div className=\"absolute inset-0 p-8 flex flex-col justify-end\">\n             