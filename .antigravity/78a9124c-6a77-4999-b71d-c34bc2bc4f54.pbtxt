        lines {
          text: "    if (isInView) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      let start = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const end = numericValue;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
