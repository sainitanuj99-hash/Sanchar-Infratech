    replacement_chunks {
      target_content: "const CalculatorSection = () => {\n  const [area, setArea] = useState(1000);\n  const [type, setType] = useState(\'residential\');\n  \n  const rates = {\n    residential: 1850,\n    commercial: 2400,\n    industrial: 1600\n  };\n\n  const estimate = area * rates[type as keyof typeof rates];\n\n  return (\n    <section className=\"py-24 bg-white px-6\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"bg-blue-50/50 rounded-[60px] p-8 md:p-16 border border-blue-100/50 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\n          <div>\n            <h2 className=\"text-sm font-bold tracking-[0.2em] uppercase text-blue-400/60 mb-4\">Precision Planning</h2>\n            <h3 className=\"text-4xl md:text-5xl font-bold tracking-tight text-slate-900 mb-8 font-sans\">\n              Instant Project <br /> <span className=\"text-blue-300 italic font-serif\">Cost Estimator.</span>\n            </h3>\n            <p className=\"text-slate-500 mb-10 font-light\">\n              Get an immediate ballpark architectural and structural estimate for your next monumental project.\n            </p>\n            \n            <div className=\"space-y-8\">\n              <div>\n                <label className=\"text-[10px] font-black uppercase tracking-[0.2em] text-blue-400/40 mb-4 block\">Project Type</label>\n                <div className=\"flex flex-wrap gap-4\">\n                  {Object.keys(rates).map(r => (\n                    <button \n                      key={r}\n                      onClick={() => setType(r)}\n                      className={`px-6 py-3 rounded-2xl text-xs font-bold uppercase tracking-widest transition-all ${type === r ? \'bg-blue-600 text-white shadow-lg shadow-blue-600/20\' : \'bg-white border border-blue-100 text-slate-500 hover:border-blue-600\'}`}\n                    >\n                      {r}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <div>\n                <label className=\"text-[10px] font-black uppercase tracking-[0.2em] text-blue-400/40 mb-4 block\">Approx Area (Sq Ft): {area}</label>\n                <input \n                  type=\"range\" \n                  min=\"500\" \n                  max=\"50000\" \n                  step=\"100\"\n                  value={area}\n                  onChange={(e) => setArea(parseInt(e.target.value))}\n                  className=\"w-full h-2 bg-blue-100 rounded-lg appearance-none cursor-pointer accent-blue-600\"\n                />\n              </div>\n            </div>\n          </div>\n\n          <div className=\"bg-white rounded-[40px] p-10 shadow-2xl shadow-zinc-200/50 border border-zinc-100 text-center\">\n            <div className=\"w-16 h-16 bg-zinc-950 text-white rounded-2xl flex items-center justify-center mx-auto mb-6\">\n              <Calculator size={32} />\n            </div>\n            <p className=\"text-[10px] font-black uppercase tracking-[0.3em] text-zinc-400 mb-2\">Estimated Investment</p>\n            <h4 className=\"text-5xl md:text-6xl font-black tracking-tighter text-zinc-900 mb-4\">\n              \342\202\271{(estimate / 100000).toFixed(2)}L*\n            </h4>\n            <p className=\"text-zinc-400 text-xs mb-8\">*(Standard structural & finish inclusive)</p>\n            <button className=\"w-full bg-black text-white py-5 rounded-2xl font-bold uppercase tracking-widest text-xs hover:bg-zinc-800 transition-colors\">\n              Get Detailed Quotation\n            </button>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};"
      replacement_content: "const CalculatorSection = () => {\n  const [area, setArea] = useState(1000);\n  const [type, setType] = useState(\'residential\');\n  \n  const rates = {\n    residential: 1850,\n    commercial: 2400,\n    industrial: 1600\n  };\n\n  const estimate = area * rates[type as keyof typeof rates];\n\n  return (\n    <section className=\"py-24 bg-white px-6\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"bg-zinc-50 rounded-[60px] p-8 md:p-16 border border-zinc-100 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\n          <div>\n            <h2 className=\"text-sm font-bold tracking-[0.2em] uppercase text-teal-600/40 mb-4\">Precision Planning</h2>\n            <h3 className=\"text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 mb-8 font-sans\">\n              Instant Project <br /> <span className=\"text-teal-500 italic font-serif\">Cost Estimator.</span>\n            </h3>\n            <p className=\"text-zinc-500 mb-10 font-light\">\n              Get an immediate ballpark architectural and structural estimate for your next monumental project.\n            </p>\n            \n            <div className=\"space-y-8\">\n              <div>\n                <label className=\"text-[10px] font-black uppercase tracking-[0.2em] text-teal-600/40 mb-4 block\">Project Type</label>\n                <div className=\"flex flex-wrap gap-4\">\n                  {Object.keys(rates).map(r => (\n                    <button \n                      key={r}\n                      onClick={() => setType(r)}\n                      className={`px-6 py-3 rounded-2xl text-xs font-bold uppercase tracking-widest transition-all ${type === r ? \'bg-teal-500 text-white shadow-lg shadow-teal-500/20\' : \'bg-white border border-zinc-200 text-zinc-500 hover:border-teal-500\'}`}\n                    >\n                      {r}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <div>\n                <label className=\"text-[10px] font-black uppercase tracking-[0.2em] text-teal-600/40 mb-4 block\">Approx Area (Sq Ft): {area}</label>\n                <input \n                  type=\"range\" \n                  min=\"500\" \n                  max=\"50000\" \n                  step=\"100\"\n                  value={area}\n                  onChange={(e) => setArea(parseInt(e.target.value))}\n                  className=\"w-full h-2 bg-zinc-200 rounded-lg appearance-none cursor-pointer accent-teal-500\"\n                />\n              </div>\n            </div>\n          </div>\n\n          <div className=\"bg-white rounded-[40px] p-10 shadow-2xl shadow-zinc-200/50 border border-zinc-100 text-center\">\n            <div className=\"w-16 h-16 bg-zinc-950 text-white rounded-2xl flex items-center justify-center mx-auto mb-6\">\n              <Calculator size={32} />\n            </div>\n            <p className=\"text-[10px] font-black uppercase tracking-[0.3em] text-zinc-400 mb-2\">Estimated Investment</p>\n            <h4 className=\"text-5xl md:text-6xl font-black tracking-tighter text-zinc-900 mb-4\">\n              \342\202\271{(estimate / 100000).toFixed(2)}L*\n            </h4>\n            <p className=\"text-zinc-400 text-xs mb-8\">*(Standard structural & finish inclusive)</p>\n            <button className=\"w-full bg-teal-500 text-white py-5 rounded-2xl font-bold uppercase tracking-widest text-xs hover:bg-teal-600 transition-colors shadow-lg shadow-teal-500/10\">\n              Get Detailed Quotation\n            </button>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};"
    }
