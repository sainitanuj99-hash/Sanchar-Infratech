    replacement_chunks {
      target_content: "const VastuPopup = () => {\n  const [show, setShow] = useState(false);\n\n  useEffect(() => {\n    const timer = setTimeout(() => setShow(true), 5000);\n    return () => clearTimeout(timer);\n  }, []);\n\n  return (\n    <AnimatePresence>\n      {show && (\n        <motion.div \n          initial={{ opacity: 0, y: 50, scale: 0.9 }}\n          animate={{ opacity: 1, y: 0, scale: 1 }}\n          exit={{ opacity: 0, scale: 0.9 }}\n          className=\"fixed bottom-8 right-8 z-[100] w-[350px] bg-zinc-900 rounded-[32px] p-8 text-white shadow-2xl border border-white/10\"\n        >\n          <button \n            onClick={() => setShow(false)}\n            className=\"absolute top-4 right-4 text-white/40 hover:text-white\"\n          >\n            <X size={18} />\n          </button>\n          <div className=\"w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center mb-6\">\n            <Compass className=\"text-white\" />\n          </div>\n          <h4 className=\"text-xl font-bold mb-2\">Free Vastu Audit</h4>\n          <p className=\"text-white/50 text-sm mb-6 leading-relaxed\">\n            Planning a new space? Get our exclusive \"Vastu for Modern Infrastructure\" PDF guide for free.\n          </p>\n          <div className=\"space-y-3\">\n             <input type=\"email\" placeholder=\"Your Email\" className=\"w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-white transition-all\" />\n             <button className=\"w-full bg-white text-black py-3 rounded-xl text-xs font-bold uppercase tracking-widest flex items-center justify-center gap-2\">\n               <Download size={14} /> Download Guide\n             </button>\n          </div>\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n};"
      replacement_content: "const VastuPopup = () => {\n  const [show, setShow] = useState(false);\n\n  useEffect(() => {\n    const timer = setTimeout(() => setShow(true), 15000); // Delayed slightly longer\n    return () => clearTimeout(timer);\n  }, []);\n\n  return (\n    <AnimatePresence>\n      {show && (\n        <motion.div \n          initial={{ opacity: 0, y: 50, scale: 0.9 }}\n          animate={{ opacity: 1, y: 0, scale: 1 }}\n          exit={{ opacity: 0, scale: 0.9 }}\n          className=\"fixed bottom-8 right-8 z-[100] w-[350px] bg-slate-950 rounded-[32px] p-8 text-white shadow-2xl border border-blue-500/20\"\n        >\n          <button \n            onClick={() => setShow(false)}\n            className=\"absolute top-4 right-4 text-white/40 hover:text-white\"\n          >\n            <X size={18} />\n          </button>\n          <div className=\"w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center mb-6 shadow-lg shadow-blue-600/30\">\n            <Compass className=\"text-white\" size={24} />\n          </div>\n          <h4 className=\"text-xl font-bold mb-2\">Free Vastu Audit</h4>\n          <p className=\"text-slate-400 text-sm mb-6 leading-relaxed\">\n            Planning a new space? Get our exclusive \"Vastu for Modern Infrastructure\" PDF guide for free.\n          </p>\n          <div className=\"space-y-3\">\n             <input type=\"email\" placeholder=\"Your Email\" className=\"w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all font-light\" />\n             <button className=\"w-full bg-blue-600 text-white py-3 rounded-xl text-xs font-bold uppercase tracking-widest flex items-center justify-center gap-2 hover:bg-blue-700 transition-colors shadow-lg shadow-blue-600/20\">\n               <Download size={14} /> Download Guide\n             </button>\n          </div>\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n};"
    }
    replacement_chunks {
      target_content: "const ValuesSection = () => {\n  return (\n    <section className=\"py-24 bg-white px-6\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"text-center mb-16\">\n          <h2 className=\"text-sm font-bold tracking-[0.2em] uppercase text-zinc-400 mb-4\">Differentiators</h2>\n          <h3 className=\"text-4xl md:text-6xl font-bold tracking-tight text-zinc-900 font-sans\">\n            Why Leaders Choose <br /> <span className=\"text-zinc-300 italic font-serif\">Sanchar Infratech.</span>\n          </h3>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-4 grid-rows-2 gap-4 h-auto md:h-[800px]\">\n          {/* Large Featured Card */}\n          <motion.div \n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            className=\"md:col-span-2 md:row-span-2 bg-zinc-950 rounded-[40px] p-12 text-white flex flex-col justify-between overflow-hidden relative group\"\n          >\n            <div className=\"relative z-10\">\n              <Zap className=\"w-12 h-12 mb-8 text-white/50\" />\n              <h4 className=\"text-3xl font-bold mb-4\">Innovation First</h4>\n              <p className=\"text-zinc-400 text-lg leading-relaxed max-w-sm\">\n                Integrating cutting-edge technology and materials in every build to ensure longevity and efficiency.\n              </p>\n            </div>\n            <div className=\"absolute inset-0 opacity-20 transition-transform duration-700 group-hover:scale-110\">\n               <img src=\"https://images.unsplash.com/photo-1541888946425-d81bb19240f5?q=80&w=2070&auto=format&fit=crop\" alt=\"Innovation\" className=\"w-full h-full object-cover\" />\n            </div>\n            <div className=\"relative z-10 pt-12\">\n               <div className=\"flex gap-2\">\n                 <span className=\"px-3 py-1 bg-white/10 rounded-full text-[10px] font-bold uppercase tracking-widest border border-white/10\">BIM Modeling</span>\n                 <span className=\"px-3 py-1 bg-white/10 rounded-full text-[10px] font-bold uppercase tracking-widest border border-white/10\">Smart Infrastructure</span>\n               </div>\n            </div>\n          </motion.div>\n\n          {/* Medium Secondary Cards */}\n          <motion.div \n            initial={{ opacity: 0, x: 20 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true }}\n            className=\"md:col-span-2 bg-zinc-50 rounded-[40px] p-10 border border-zinc-100 flex flex-col justify-center\"\n          >\n            <div className=\"flex items-center gap-6 mb-6\">\n              <div className=\"w-14 h-14 bg-black text-white rounded-2xl flex items-center justify-center\">\n                <ShieldCheck size={28} />\n              </div>\n              <h4 className=\"text-2xl font-bold tracking-tight\">Zero-Compromise Safety</h4>\n            </div>\n            <p className=\"text-zinc-500 leading-relaxed\">\n              Our safety protocols exceed international standards, ensuring every operative on-site works in a fortress of compliance and security.\n            </p>\n          </motion.div>\n\n          <motion.div \n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            className=\"bg-zinc-100 rounded-[40px] p-8 flex flex-col justify-end group cursor-pointer overflow-hidden relative\"\n          >\n            <Globe className=\"w-8 h-8 mb-4 text-zinc-900 z-10\" />\n            <h4 className=\"text-xl font-bold text-zinc-900 z-10\">Sustainability</h4>\n            <div className=\"absolute inset-0 bg-black opacity-0 group-hover:opacity-90 transition-all duration-500 flex items-center p-8 z-20\">\n               <p className=\"text-white text-xs leading-relaxed\">Eco-conscious designs that minimize environmental footprint through carbon-neutral construction methods.</p>\n            </div>\n          </motion.div>\n\n          <motion.div \n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            className=\"bg-zinc-900 text-white rounded-[40px] p-8 flex flex-col justify-end relative overflow-hidden\"\n          >\n             <Users className=\"w-8 h-8 mb-4 opacity-50\" />\n             <h4 className=\"text-xl font-bold\">Client Centricity</h4>\n             <div className=\"absolute top-0 right-0 p-4 opacity-10\">\n                <Target size={120} />\n             </div>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n};"
      replacement_content: "const ValuesSection = () => {\n  return (\n    <section className=\"py-24 bg-white px-6\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"text-center mb-16\">\n          <h2 className=\"text-sm font-bold tracking-[0.2em] uppercase text-blue-400 mb-4\">Differentiators</h2>\n          <h3 className=\"text-4xl md:text-6xl font-bold tracking-tight text-slate-900 font-sans\">\n            Why Leaders Choose <br /> <span className=\"text-blue-200 italic font-serif\">Sanchar Infratech.</span>\n          </h3>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-4 grid-rows-2 gap-4 h-auto md:h-[800px]\">\n          {/* Large Featured Card */}\n          <motion.div \n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            className=\"md:col-span-2 md:row-span-2 bg-slate-950 rounded-[40px] p-12 text-white flex flex-col justify-between overflow-hidden relative group\"\n          >\n            <div className=\"relative z-10\">\n              <Zap className=\"w-12 h-12 mb-8 text-blue-400/50\" />\n              <h4 className=\"text-3xl font-bold mb-4\">Innovation First</h4>\n              <p className=\"text-slate-400 text-lg leading-relaxed max-w-sm font-light\">\n                Integrating cutting-edge technology and materials in every build to ensure longevity and efficiency.\n              </p>\n            </div>\n            <div className=\"absolute inset-0 opacity-20 transition-transform duration-700 group-hover:scale-110 pointer-events-none\">\n               <img src=\"https://images.unsplash.com/photo-1541888946425-d81bb19240f5?q=80&w=2070&auto=format&fit=crop\" alt=\"Innovation\" className=\"w-full h-full object-cover\" referrerPolicy=\"no-referrer\" />\n            </div>\n            <div className=\"relative z-10 pt-12\">\n               <div className=\"flex gap-2\">\n                 <span className=\"px-3 py-1 bg-blue-500/10 rounded-full text-[10px] font-bold uppercase tracking-widest border border-blue-500/20\">BIM Modeling</span>\n                 <span className=\"px-3 py-1 bg-blue-500/10 rounded-full text-[10px] font-bold uppercase tracking-widest border border-blue-500/20\">Smart Infrastructure</span>\n               </div>\n            </div>\n          </motion.div>\n\n          {/* Medium Secondary Cards */}\n          <motion.div \n            initial={{ opacity: 0, x: 20 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true }}\n            className=\"md:col-span-2 bg-blue-50/50 rounded-[40px] p-10 border border-blue-100/50 flex flex-col justify-center\"\n          >\n            <div className=\"flex items-center gap-6 mb-6\">\n              <div className=\"w-14 h-14 bg-blue-600 text-white rounded-2xl flex items-center justify-center shadow-lg shadow-blue-600/20\">\n                <ShieldCheck size={28} />\n              </div>\n              <h4 className=\"text-2xl font-bold tracking-tight text-slate-900\">Zero-Compromise Safety</h4>\n            </div>\n            <p className=\"text-slate-500 leading-relaxed font-light\">\n              Our safety protocols exceed international standards, ensuring every operative on-site works in a fortress of compliance and security.\n            </p>\n          </motion.div>\n\n          <motion.div \n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            className=\"bg-blue-50 rounded-[40px] p-8 flex flex-col justify-end group cursor-pointer overflow-hidden relative shadow-sm hover:shadow-blue-100 transition-all\"\n          >\n            <Globe className=\"w-8 h-8 mb-4 text-blue-600 z-10\" />\n            <h4 className=\"text-xl font-bold text-slate-900 z-10\">Sustainability</h4>\n            <div className=\"absolute inset-0 bg-blue-600 opacity-0 group-hover:opacity-95 transition-all duration-500 flex items-center p-8 z-20\">\n               <p className=\"text-white text-xs leading-relaxed font-light\">Eco-conscious designs that minimize environmental footprint through carbon-neutral construction methods.</p>\n            </div>\n          </motion.div>\n\n          <motion.div \n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            className=\"bg-slate-900 text-white rounded-[40px] p-8 flex flex-col justify-end relative overflow-hidden group hover:bg-slate-800 transition-colors\"\n          >\n             <Users className=\"w-8 h-8 mb-4 opacity-50 text-blue-400\" />\n             <h4 className=\"text-xl font-bold\">Client Centricity</h4>\n             <div className=\"absolute top-0 right-0 p-4 opacity-[0.03] group-hover:opacity-[0.07] transition-all\">\n                <Target size={120} />\n             </div>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n};"
