  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState, useEffect } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  Building2, \n  Home, \n  DraftingCompass, \n  Trophy, \n  Compass, \n  ArrowRight, \n  Menu, \n  X, \n  Mail, \n  Phone, \n  MapPin,\n  ChevronDown,\n  Globe,\n  Zap,\n  ShieldCheck,\n  Cpu,\n  Users,\n  Target,\n  BarChart3\n} from \'lucide-react\';\n"
      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { motion, AnimatePresence, useScroll, useTransform, useSpring, useInView } from \'motion/react\';\nimport { \n  Building2, \n  Home, \n  DraftingCompass, \n  Trophy, \n  Compass, \n  ArrowRight, \n  Menu, \n  X, \n  Mail, \n  Phone, \n  MapPin,\n  ChevronDown,\n  Globe,\n  Zap,\n  ShieldCheck,\n  Cpu,\n  Users,\n  Target,\n  BarChart3,\n  Video,\n  UserCheck,\n  Eye,\n  Calculator,\n  Download\n} from \'lucide-react\';\n"
    }
    replacement_chunks {
      target_content: "const SECTORS = [\n"
      replacement_content: "const BRANDS = [\n  \"Adani Realty\", \"Godrej Properties\", \"DLF\", \"L&T Construction\", \"Tata Projects\", \"Shapoorji Pallonji\", \"Brigade Group\", \"Oberoi Realty\"\n];\n\nconst TRANSPARENCY_FEATURES = [\n  {\n    title: \'Dedicated Manager\',\n    desc: \'Single point of contact for seamless communication and accountability.\',\n    icon: UserCheck\n  },\n  {\n    title: \'24/7 Surveillance\',\n    desc: \'Live camera access to your project site from anywhere in the world.\',\n    icon: Video\n  },\n  {\n    title: \'Real-time Tracking\',\n    desc: \'Daily progress reports with high-resolution imagery and logs.\',\n    icon: Eye\n  }\n];\n\n// --- Sub-components ---\n\nconst Counter = ({ value, suffix = \"\" }: { value: string, suffix?: string }) => {\n  const numericValue = parseInt(value);\n  const [count, setCount] = useState(0);\n  const ref = useRef(null);\n  const isInView = useInView(ref, { once: true });\n\n  useEffect(() => {\n    if (isInView) {\n      let start = 0;\n      const end = numericValue;\n      if (start === end) return;\n\n      const duration = 2000;\n      const increment = end / (duration / 16);\n\n      const timer = setInterval(() => {\n        start += increment;\n        if (start >= end) {\n          setCount(end);\n          clearInterval(timer);\n        } else {\n          setCount(Math.floor(start));\n        }\n      }, 16);\n\n      return () => clearInterval(timer);\n    }\n  }, [isInView, numericValue]);\n\n  return (\n    <span ref={ref} className=\"tabular-nums\">\n      {count}{suffix}\n    </span>\n  );\n};\n\nconst BrandsTicker = () => {\n  return (\n    <div className=\"py-12 bg-zinc-50 border-y border-zinc-100 overflow-hidden whitespace-nowrap relative\">\n      <div className=\"absolute left-0 top-0 w-24 h-full bg-gradient-to-r from-zinc-50 to-transparent z-10\" />\n      <div className=\"absolute right-0 top-0 w-24 h-full bg-gradient-to-l from-zinc-50 to-transparent z-10\" />\n      <motion.div \n        animate={{ x: [\"0%\", \"-50%\"] }}\n        transition={{ duration: 30, repeat: Infinity, ease: \"linear\" }}\n        className=\"inline-block\"\n      >\n        <div className=\"flex gap-20 items-center\">\n          {[...BRANDS, ...BRANDS].map((brand, i) => (\n            <span key={i} className=\"text-zinc-300 text-2xl font-black tracking-widest uppercase hover:text-zinc-900 transition-colors cursor-default\">\n              {brand}\n            </span>\n          ))}\n        </div>\n      </motion.div>\n    </div>\n  );\n};\n"
    }
    replacement_chunks {
      target_content: "const StatsSection = () => {\n  return (\n    <section className=\"py-20 bg-white border-b border-zinc-100\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-12\">\n          {STATS.map((stat, idx) => (\n            <motion.div \n              key={stat.label}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              transition={{ delay: idx * 0.1 }}\n              viewport={{ once: true }}\n              className=\"text-center lg:text-left\"\n            >\n              <div className=\"flex flex-col lg:flex-row items-center gap-4\">\n                <div className=\"w-12 h-12 rounded-full bg-zinc-50 flex items-center justify-center text-zinc-900\">\n                  <stat.icon size={24} />\n                </div>\n                <div>\n                  <p className=\"text-4xl font-extrabold tracking-tighter text-zinc-900\">{stat.value}</p>\n                  <p className=\"text-xs font-bold text-zinc-400 uppercase tracking-widest mt-1\">{stat.label}</p>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n"
      replacement_content: "const StatsSection = () => {\n  return (\n    <section className=\"py-20 bg-white border-b border-zinc-100\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-12\">\n          {STATS.map((stat, idx) => (\n            <motion.div \n              key={stat.label}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              transition={{ delay: idx * 0.1 }}\n              viewport={{ once: true }}\n              className=\"text-center lg:text-left\"\n            >\n              <div className=\"flex flex-col lg:flex-row items-center gap-4\">\n                <div className=\"w-12 h-12 rounded-full bg-zinc-50 flex items-center justify-center text-zinc-900\">\n                  <stat.icon size={24} />\n                </div>\n                <div>\n                  <p className=\"text-4xl font-extrabold tracking-tighter text-zinc-900\">\n                    <Counter \n                      value={stat.value.replace(/[^0-9]/g, \'\')} \n                      suffix={stat.value.replace(/[0-9]/g, \'\')} \n                    />\n                  </p>\n                  <p className=\"text-xs font-bold text-zinc-400 uppercase tracking-widest mt-1\">{stat.label}</p>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst TransparencySection = () => {\n  return (\n    <section className=\"py-24 bg-zinc-950 px-6 overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\">\n          <motion.div\n            initial={{ opacity: 0, x: -50 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true }}\n          >\n            <h2 className=\"text-white/40 text-sm font-bold tracking-[0.2em] uppercase mb-4\">Radical Transparency</h2>\n            <h3 className=\"text-4xl md:text-5xl font-bold text-white tracking-tight mb-8\">\n              Watch your vision <br />\n              <span className=\"italic font-light text-white/50 font-serif text-6xl\">Take Shape Live.</span>\n            </h3>\n            <p className=\"text-zinc-400 text-lg leading-relaxed mb-10 max-w-lg\">\n              We eliminate the \"Black Box\" of construction. With Sanchar Infratech, you possess full visibility over every brick, beam, and finish.\n            </p>\n            \n            <div className=\"space-y-8\">\n              {TRANSPARENCY_FEATURES.map((feature, idx) => (\n                <div key={feature.title} className=\"flex gap-6 group\">\n                  <div className=\"flex-shrink-0 w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center text-white group-hover:bg-white group-hover:text-black transition-all\">\n                    <feature.icon size={24} />\n                  </div>\n                  <div>\n                    <h4 className=\"text-white font-bold mb-1 uppercase tracking-widest text-xs\">{feature.title}</h4>\n                    <p className=\"text-zinc-500 text-xs leading-relaxed\">{feature.desc}</p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </motion.div>\n\n          <div className=\"relative\">\n             <div className=\"aspect-video bg-zinc-900 rounded-[40px] overflow-hidden border border-white/10 relative group\">\n                <img \n                  src=\"https://images.unsplash.com/photo-1541888946425-d81bb19240f5?q=80&w=2070&auto=format&fit=crop\" \n                  alt=\"Live Site\"\n                  className=\"w-full h-full object-cover opacity-50 group-hover:scale-105 transition-transform duration-700\"\n                />\n                <div className=\"absolute inset-0 flex items-center justify-center\">\n                    <div className=\"w-20 h-20 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center border border-white/20 animate-pulse\">\n                      <div className=\"w-3 h-3 bg-red-600 rounded-full animate-ping\" />\n                    </div>\n                </div>\n                <div className=\"absolute top-6 left-6 flex items-center gap-2 bg-red-600/20 backdrop-blur-md px-3 py-1 rounded-full border border-red-600/50\">\n                  <span className=\"w-1.5 h-1.5 bg-red-600 rounded-full\" />\n                  <span className=\"text-[10px] text-red-500 font-bold uppercase tracking-widest\">Live: Site-047</span>\n                </div>\n                <div className=\"absolute bottom-6 right-6 flex items-center gap-4\">\n                  <div className=\"flex flex-col items-end\">\n                    <span className=\"text-white text-xl font-bold tracking-tighter\">18:24:05</span>\n                    <span className=\"text-white/40 text-[8px] uppercase tracking-widest\">GMT +5:30</span>\n                  </div>\n                </div>\n             </div>\n             <div className=\"absolute -bottom-6 -left-6 bg-white p-6 rounded-3xl shadow-2xl border border-zinc-100 hidden md:block\">\n                <div className=\"flex items-center gap-4\">\n                   <div className=\"w-10 h-10 rounded-full bg-zinc-100 overflow-hidden\">\n                     <img src=\"https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=2070&auto=format&fit=crop\" alt=\"Manager\" className=\"w-full h-full object-cover\" />\n                   </div>\n                   <div>\n                     <p className=\"text-[10px] font-bold text-zinc-400 uppercase tracking-widest\">On-Site Manager</p>\n                     <p className=\"text-sm font-bold text-zinc-900\">Arjun Verma</p>\n                   </div>\n                </div>\n             </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst CalculatorSection = () => {\n  const [area, setArea] = useState(1000);\n  const [type, setType] = useState(\'residential\');\n  \n  const rates = {\n    residential: 1850,\n    commercial: 2400,\n    industrial: 1600\n  };\n\n  const estimate = area * rates[type as keyof typeof rates];\n\n  return (\n    <section className=\"py-24 bg-white px-6\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"bg-zinc-50 rounded-[60px] p-8 md:p-16 border border-zinc-100 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\n          <div>\n            <h2 className=\"text-sm font-bold tracking-[0.2em] uppercase text-zinc-400 mb-4\">Precision Planning</h2>\n            <h3 className=\"text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 mb-8 font-sans\">\n              Instant Project <br /> <span className=\"text-zinc-300 italic font-serif\">Cost Estimator.</span>\n            </h3>\n            <p className=\"text-zinc-500 mb-10\">\n              Get an immediate ballpark architectural and structural estimate for your next monumental project.\n            </p>\n            \n            <div className=\"space-y-8\">\n              <div>\n                <label className=\"text-[10px] font-black uppercase tracking-[0.2em] text-zinc-400 mb-4 block\">Project Type</label>\n                <div className=\"flex flex-wrap gap-4\">\n                  {Object.keys(rates).map(r => (\n                    <button \n                      key={r}\n                      onClick={() => setType(r)}\n                      className={`px-6 py-3 rounded-2xl text-xs font-bold uppercase tracking-widest transition-all ${type === r ? \'bg-black text-white\' : \'bg-white border border-zinc-200 text-zinc-500 hover:border-black\'}`}\n                    >\n                      {r}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <div>\n                <label className=\"text-[10px] font-black uppercase tracking-[0.2em] text-zinc-400 mb-4 block\">Approx Area (Sq Ft): {area}</label>\n                <input \n                  type=\"range\" \n                  min=\"500\" \n                  max=\"50000\" \n                  step=\"100\"\n                  value={area}\n                  onChange={(e) => setArea(parseInt(e.target.value))}\n                  className=\"w-full h-2 bg-zinc-200 rounded-lg appearance-none cursor-pointer accent-black\"\n                />\n              </div>\n            </div>\n          </div>\n\n          <div className=\"bg-white rounded-[40px] p-10 shadow-2xl shadow-zinc-200/50 border border-zinc-100 text-center\">\n            <div className=\"w-16 h-16 bg-zinc-950 text-white rounded-2xl flex items-center justify-center mx-auto mb-6\">\n              <Calculator size={32} />\n            </div>\n            <p className=\"text-[10px] font-black uppercase tracking-[0.3em] text-zinc-400 mb-2\">Estimated Investment</p>\n            <h4 className=\"text-5xl md:text-6xl font-black tracking-tighter text-zinc-900 mb-4\">\n              \342\202\271{(estimate / 100000).toFixed(2)}L*\n            </h4>\n            <p className=\"text-zinc-400 text-xs mb-8\">*(Standard structural & finish inclusive)</p>\n            <button className=\"w-full bg-black text-white py-5 rounded-2xl font-bold uppercase tracking-widest text-xs hover:bg-zinc-800 transition-colors\">\n              Get Detailed Quotation\n            </button>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst VastuPopup = () => {\n  const [show, setShow] = useState(false);\n\n  useEffect(() => {\n    const timer = setTimeout(() => setShow(true), 5000);\n    return () => clearTimeout(timer);\n  }, []);\n\n  return (\n    <AnimatePresence>\n      {show && (\n        <motion.div \n          initial={{ opacity: 0, y: 50, scale: 0.9 }}\n          animate={{ opacity: 1, y: 0, scale: 1 }}\n          exit={{ opacity: 0, scale: 0.9 }}\n          className=\"fixed bottom-8 right-8 z-[100] w-[350px] bg-zinc-900 rounded-[32px] p-8 text-white shadow-2xl border border-white/10\"\n        >\n          <button \n            onClick={() => setShow(false)}\n            className=\"absolute top-4 right-4 text-white/40 hover:text-white\"\n          >\n            <X size={18} />\n          </button>\n          <div className=\"w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center mb-6\">\n            <Compass className=\"text-white\" />\n          </div>\n          <h4 className=\"text-xl font-bold mb-2\">Free Vastu Audit</h4>\n          <p className=\"text-white/50 text-sm mb-6 leading-relaxed\">\n            Planning a new space? Get our exclusive \"Vastu for Modern Infrastructure\" PDF guide for free.\n          </p>\n          <div className=\"space-y-3\">\n             <input type=\"email\" placeholder=\"Your Email\" className=\"w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-white transition-all\" />\n             <button className=\"w-full bg-white text-black py-3 rounded-xl text-xs font-bold uppercase tracking-widest flex items-center justify-center gap-2\">\n               <Download size={14} /> Download Guide\n             </button>\n          </div>\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n};\n"
    }
