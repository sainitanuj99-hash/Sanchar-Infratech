px-12\">\n          {[...BRANDS, ...BRANDS, ...BRANDS].map((brand, i) => (\n            <div key={i} className=\"flex items-center group/item cursor-pointer filter grayscale hover:grayscale-0 transition-all duration-500\">\n               <img \n                 src={brand.logo} \n                 alt={brand.name} \n                 className=\"h-12 md:h-16 w-auto object-contain opacity-50 group-hover/item:opacity-100 transition-opacity\"\n                 onError={(e) => {\n                   (e.target as HTMLImageElement).style.display = \'none\';\n                   (e.target as HTMLImageElement).nextElementSibling?.classList.remove(\'hidden\');\n                 }}\n                 referrerPolicy=\"no-referrer\"\n               />\n               <span className=\"hidden text-zinc-900 text-xl font-black tracking-tighter uppercase group-hover/item:text-teal-600 transition-colors\">\n                 {brand.name}\n               </span>\n            </div>\n          ))}\n        </div>\n      </motion.div>\n    </div>\n  );\n};"
      replacement_content: "const BRANDS = [\n  { name: \"Jai Club\", logo: \"https://jaiclubjaipur.com/wp-content/uploads/2021/11/logo.png\" },\n  { name: \"Mahima Group\", logo: \"https://mahimagroup.com/wp-content/uploads/2022/02/mahima-logo.png\" },\n  { name: \"SNG Group\", logo: \"https://snggroupindia.com/wp-content/themes/sng/images/logo.png\" },\n  { name: \"Patrika Rajasthan\", logo: \"https://upload.wikimedia.org/wikipedia/en/thumb/f/f6/Rajasthan_Patrika.png/200px-Rajasthan_Patrika.png\" },\n  { name: \"Wish Empire\", logo: \"https://wishempire.com/wp-content/uploads/2023/10/wish-empire-logo.png\" },\n];\n\nconst TRANSPARENCY_FEATURES = [\n  { title: \'24/7 Live Stream\', icon: Camera, desc: \'HD surveillance on every site, accessible from your personal dashboard.\' },\n  { title: \'BIM Integration\', icon: Maximize, desc: \'Compare real-world progress against digital twins in real-time.\' },\n  { title: \'Cloud Ledger\', icon: Lock, desc: \'Encrypted financial logs and material procurement receipts for total auditability.\' }\n];\n\nconst BrandsTicker = () => {\n  return (\n    <div className=\"py-20 bg-white border-y border-zinc-100 overflow-hidden whitespace-nowrap relative group\">\n      <div className=\"max-w-7xl mx-auto px-6 mb-12 flex items-center gap-4\">\n        <h2 className=\"text-[10px] font-black uppercase tracking-[0.4em] text-zinc-400\">Prestigious Collaborations</h2>\n        <div className=\"h-[1px] flex-grow bg-zinc-100\" />\n      </div>\n      \n      <div className=\"absolute left-0 top-0 w-48 h-full bg-gradient-to-r from-white via-white/80 to-transparent z-20 pointer-events-none\" />\n      <div className=\"absolute right-0 top-0 w-48 h-full bg-gradient-to-l from-white via-white/80 to-transparent z-20 pointer-events-none\" />\n      \n      <motion.div \n        animate={{ x: [\"0%\", \"-50%\"] }}\n        transition={{ duration: 45, repeat: Infinity, ease: \"linear\" }}\n        className=\"inline-block\"\n      >\n        <div className=\"flex gap-24 items-center px-12\">\n          {[...BRANDS, ...BRANDS, ...BRANDS].map((brand, i) => (\n            <div \n              key={i} \n              className=\"flex items-center justify-center h-20 px-8 group/item cursor-pointer\"\n            >\n               <img \n                 src={brand.logo} \n                 alt={brand.name} \n                 className=\"h-12 md:h-16 w-auto object-contain filter grayscale opacity-40 group-hover/item:grayscale-0 group-hover/item:opacity-100 transition-all duration-700 hover:scale-110\"\n                 onError={(e) => {\n                   const target = e.target as HTMLImageElement;\n                   target.style.display = \'none\';\n                   const fallback = target.nextElementSibling as HTMLElement;\n                   if (fallback) fallback.classList.remove(\'hidden\');\n                 }}\n                 referrerPolicy=\"no-referrer\"\n               />\n               <span className=\"hidden text-zinc-900 text-lg font-black tracking-tighter uppercase group-hover/item:text-teal-600 transition-colors\">\n                 {brand.name}\n               </span>\n            </div>\n          ))}\n        </div>\n      </motion.div>\n    </div>\n  );\n};"
    }
    instruction: "Update BRANDS with actual logo URLs and refine BrandsTicker to display logos prominently without text."
  }
