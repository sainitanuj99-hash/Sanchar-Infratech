ld uppercase tracking-widest focus:ring-1 focus:ring-blue-600 transition-all outline-none\" />\n                    <input type=\"text\" placeholder=\"Last Name\" className=\"w-full p-5 bg-white rounded-2xl border border-blue-100 text-xs font-bold uppercase tracking-widest focus:ring-1 focus:ring-blue-600 transition-all outline-none\" />\n                  </div>\n                  <input type=\"email\" placeholder=\"Corporate Email\" className=\"w-full p-5 bg-white rounded-2xl border border-blue-100 text-xs font-bold uppercase tracking-widest focus:ring-1 focus:ring-blue-600 transition-all outline-none\" />\n                  <select className=\"w-full p-5 bg-white rounded-2xl border border-blue-100 text-xs font-bold uppercase tracking-widest focus:ring-1 focus:ring-blue-600 transition-all outline-none\">\n                     <option>Select Project Category</option>\n                     <option>Commercial</option>\n                     <option>Residential</option>\n                     <option>Sports Infratech</option>\n                  </select>\n                  <textarea placeholder=\"Tell us about your vision\" rows={4} className=\"w-full p-5 bg-white rounded-2xl border border-blue-100 text-xs font-bold uppercase tracking-widest focus:ring-1 focus:ring-blue-600 transition-all outline-none\" />\n                  <button className=\"w-full bg-blue-600 text-white p-5 rounded-2xl font-bold tracking-[0.2em] uppercase text-xs hover:bg-blue-700 transition-all transform hover:translate-y-[-2px] active:translate-y-0 shadow-lg shadow-blue-600/20\">\n                    Propel Your Project\n                  </button>\n                </form>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};"
