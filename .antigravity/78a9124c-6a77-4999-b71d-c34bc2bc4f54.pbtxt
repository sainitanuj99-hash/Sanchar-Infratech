    replacement_chunks {
      target_content: "const Connect = () => {\n  return (\n    <section id=\"connect\" className=\"py-24 bg-zinc-50 px-6\">\n      <div className=\"max-w-4xl mx-auto bg-white rounded-[40px] p-12 md:p-20 shadow-sm border border-zinc-100 relative overflow-hidden\">\n        <div className=\"absolute top-0 right-0 p-12 opacity-5 pointer-events-none\">\n          <Building2 size={240} />\n        </div>\n        \n        <div className=\"relative z-10\">\n          <h2 className=\"text-3xl md:text-5xl font-bold tracking-tight text-zinc-900 mb-8\">\n            Let\'s build the <br /> <span className=\"text-zinc-300 italic\">extraordinary.</span>\n          </h2>\n          \n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-12\">\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center gap-4 group\">\n                <div className=\"w-12 h-12 bg-zinc-100 rounded-xl flex items-center justify-center group-hover:bg-black group-hover:text-white transition-all\">\n                  <Mail className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <p className=\"text-xs font-bold text-zinc-400 uppercase tracking-widest\">Email</p>\n                  <p className=\"text-zinc-900 font-bold\">contact@sancharinfra.com</p>\n                </div>\n              </div>\n              \n              <div className=\"flex items-center gap-4 group\">\n                <div className=\"w-12 h-12 bg-zinc-100 rounded-xl flex items-center justify-center group-hover:bg-black group-hover:text-white transition-all\">\n                  <Phone className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <p className=\"text-xs font-bold text-zinc-400 uppercase tracking-widest\">Phone</p>\n                  <p className=\"text-zinc-900 font-bold\">+91 999 000 1122</p>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-4 group\">\n                <div className=\"w-12 h-12 bg-zinc-100 rounded-xl flex items-center justify-center group-hover:bg-black group-hover:text-white transition-all\">\n                  <MapPin className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <p className=\"text-xs font-bold text-zinc-400 uppercase tracking-widest\">Presence</p>\n                  <p className=\"text-zinc-900 font-bold\">Delhi \302\267 Mumbai \302\267 Dubai</p>\n                </div>\n              </div>\n            </div>\n\n            <form className=\"space-y-4\" onSubmit={(e) => e.preventDefault()}>\n              <input type=\"text\" placeholder=\"Full Name\" className=\"w-full p-4 bg-zinc-50 rounded-xl border-none text-sm font-medium focus:ring-1 focus:ring-black transition-all outline-none\" />\n              <input type=\"email\" placeholder=\"Email Address\" className=\"w-full p-4 bg-zinc-50 rounded-xl border-none text-sm font-medium focus:ring-1 focus:ring-black transition-all outline-none\" />\n              <textarea placeholder=\"Message\" rows={4} className=\"w-full p-4 bg-zinc-50 rounded-xl border-none text-sm font-medium focus:ring-1 focus:ring-black transition-all outline-none\" />\n              <button className=\"w-full bg-black text-white p-4 rounded-xl font-bold tracking-widest uppercase text-xs hover:bg-zinc-800 transition-colors\">\n                Send Enquiry\n              </button>\n            </form>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};"
      replacement_content: "const Connect = () => {\n  return (\n    <section id=\"connect\" className=\"py-24 bg-zinc-950 px-6 overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"bg-white rounded-[60px] p-8 md:p-20 shadow-2xl relative overflow-hidden\">\n          <div className=\"absolute top-0 right-0 p-12 opacity-[0.02] pointer-events-none\">\n            <Building2 size={600} />\n          </div>\n          \n          <div className=\"relative z-10\">\n            <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-20\">\n              <div>\n                <h2 className=\"text-sm font-bold tracking-[0.3em] uppercase text-zinc-400 mb-6\">Global Headquarters</h2>\n                <h3 className=\"text-4xl md:text-6xl font-black tracking-tighter text-zinc-900 mb-8 font-sans\">\n                  Let\'s Build the <br /> <span className=\"text-zinc-300 italic font-serif\">Incredible.</span>\n                </h3>\n                <p className=\"text-zinc-500 text-lg mb-12 max-w-md leading-relaxed\">\n                  Our strategic presence across major global hubs allows us to deliver world-class infrastructure without boundaries.\n                </p>\n                \n                <div className=\"space-y-8\">\n                  <div className=\"flex items-center gap-6 group\">\n                    <div className=\"w-14 h-14 bg-zinc-50 rounded-2xl flex items-center justify-center group-hover:bg-black group-hover:text-white transition-all transform group-hover:rotate-6\">\n                      <Mail className=\"w-6 h-6\" />\n                    </div>\n                    <div>\n                      <p className=\"text-[10px] font-black text-zinc-400 uppercase tracking-widest\">Inquiries</p>\n                      <p className=\"text-zinc-900 font-bold text-lg\">corp@sancharinfra.com</p>\n                    </div>\n                  </div>\n                  \n                  <div className=\"flex items-center gap-6 group\">\n                    <div className=\"w-14 h-14 bg-zinc-50 rounded-2xl flex items-center justify-center group-hover:bg-black group-hover:text-white transition-all transform group-hover:rotate-6\">\n                      <Phone className=\"w-6 h-6\" />\n                    </div>\n                    <div>\n                      <p className=\"text-[10px] font-black text-zinc-400 uppercase tracking-widest\">Connect</p>\n                      <p className=\"text-zinc-900 font-bold text-lg\">+91 11 4050 9000</p>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-6 group\">\n                    <div className=\"w-14 h-14 bg-zinc-50 rounded-2xl flex items-center justify-center group-hover:bg-black group-hover:text-white transition-all transform group-hover:rotate-6\">\n                      <MapPin className=\"w-6 h-6\" />\n                    </div>\n                    <div>\n                      <p className=\"text-[10px] font-black text-zinc-400 uppercase tracking-widest\">Global Hubs</p>\n                      <p className=\"text-zinc-900 font-bold text-sm tracking-tight capitalize\">Regus Level 4, Burjuman Business Tower, Dubai \302\267 Mumbai \302\267 New Delhi</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"bg-zinc-50 p-10 rounded-[40px] border border-zinc-100\">\n                <h4 className=\"text-xl font-bold mb-8 text-zinc-900\">Direct Inquiry</h4>\n                <form className=\"space-y-4\" onSubmit={(e) => e.preventDefault()}>\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                    <input type=\"text\" placeholder=\"First Name\" className=\"w-full p-5 bg-white rounded-2xl border border-zinc-200 text-xs font-bold uppercase tracking-widest focus:ring-1 focus:ring-black transition-all outline-none\" />\n                    <input type=\"text\" placeholder=\"Last Name\" className=\"w-full p-5 bg-white rounded-2xl border border-zinc-200 text-xs font-bold uppercase tracking-widest focus:ring-1 focus:ring-black transition-all outline-none\" />\n                  </div>\n                  <input type=\"email\" placeholder=\"Corporate Email\" className=\"w-full p-5 bg-white rounded-2xl border border-zinc-200 text-xs font-bold uppercase tracking-widest focus:ring-1 focus:ring-black transition-all outline-none\" />\n                  <select className=\"w-full p-5 bg-white rounded-2xl border border-zinc-200 text-xs font-bold uppercase tracking-widest focus:ring-1 focus:ring-black transition-all outline-none\">\n                     <option>Select Project Category</option>\n                     <option>Commercial</option>\n                     <option>Residential</option>\n                     <option>Sports Infratech</option>\n                  </select>\n                  <textarea placeholder=\"Tell us about your vision\" rows={4} className=\"w-full p-5 bg-white rounded-2xl border border-zinc-200 text-xs font-bold uppercase tracking-widest focus:ring-1 focus:ring-black transition-all outline-none\" />\n                  <button className=\"w-full bg-black text-white p-5 rounded-2xl font-bold tracking-[0.2em] uppercase text-xs hover:bg-zinc-800 transition-all transform hover:translate-y-[-2px] active:translate-y-0 shadow-lg shadow-black/10\">\n                    Propel Your Project\n                  </button>\n                </form>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};"
    }
