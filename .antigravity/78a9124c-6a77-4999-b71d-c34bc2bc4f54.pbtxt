    replacement_chunks {
      target_content: "    <nav className={`fixed top-0 w-full z-50 transition-all duration-500 py-6 ${isScrolled ? \'bg-white/80 backdrop-blur-xl border-b border-zinc-100\' : \'bg-transparent\'}`}>\n      <div className=\"max-w-7xl mx-auto px-6 flex justify-between items-center\">\n        <motion.div \n          initial={{ opacity: 0, x: -20 }}\n          animate={{ opacity: 1, x: 0 }}\n          className={`flex items-center gap-3 text-2xl font-black tracking-tighter ${isScrolled ? \'text-black\' : \'text-white\'}`}\n        >\n          <div className={`w-8 h-8 rounded-lg flex items-center justify-center ${isScrolled ? \'bg-black text-white\' : \'bg-white text-black\'}`}>\n             <Building2 size={18} />\n          </div>\n          SANCHAR.\n        </motion.div>\n\n        <div className=\"hidden md:flex space-x-10 items-center\">\n          {[\'About\', \'Sectors\', \'Projects\', \'Team\', \'Connect\'].map((item) => (\n            <a \n              key={item} \n              href={`#${item.toLowerCase()}`} \n              className={`text-[10px] font-bold tracking-[0.2em] uppercase transition-colors ${isScrolled ? \'text-zinc-600 hover:text-black\' : \'text-zinc-300 hover:text-white\'}`}\n            >\n              {item}\n            </a>\n          ))}\n          <button className={`px-6 py-2 rounded-full border text-[10px] font-black tracking-widest uppercase transition-all ${isScrolled ? \'border-black text-black hover:bg-black hover:text-white\' : \'border-white text-white hover:bg-white hover:text-black\'}`}>\n            Gallery\n          </button>\n        </div>\n\n        <button \n          className={`md:hidden w-10 h-10 rounded-full flex items-center justify-center transition-all ${isScrolled ? \'bg-black text-white\' : \'bg-white/10 backdrop-blur-md text-white\'}`}\n          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n        >\n          {mobileMenuOpen ? <X size={20} /> : <Menu size={20} />}\n        </button>\n      </div>\n\n      <AnimatePresence>\n        {mobileMenuOpen && (\n          <motion.div \n            initial={{ opacity: 0, height: 0 }}\n            animate={{ opacity: 1, height: \'auto\' }}\n            exit={{ opacity: 0, height: 0 }}\n            className=\"md:hidden bg-white border-b border-zinc-100 overflow-hidden\"\n          >\n            <div className=\"p-6 space-y-4\">\n              {[\'About\', \'Sectors\', \'Projects\', \'Team\', \'Connect\'].map((item) => (\n                <a key={item} href={`#${item.toLowerCase()}`} className=\"block text-sm font-bold text-zinc-600 uppercase tracking-widest\">{item}</a>\n              ))}\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </nav>\n  );\n};\n\nconst Hero = () => {\n  const { scrollY } = useScroll();\n  const y = useTransform(scrollY, [0, 500], [0, 200]);\n  const opacity = useTransform(scrollY, [0, 300], [1, 0]);\n\n  return (\n    <section className=\"relative h-screen flex items-center justify-center overflow-hidden bg-black\">\n      <motion.div \n        style={{ y }}\n        className=\"absolute inset-0 z-0\"\n      >\n        <img \n          src=\"https://images.unsplash.com/photo-1541976590-7139196c529d?q=80&w=2070&auto=format&fit=crop\"\n          className=\"w-full h-full object-cover opacity-60 mix-blend-overlay\"\n          alt=\"Engineering\"\n        />\n        <div className=\"absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black\" />\n      </motion.div>\n\n      <motion.div style={{ opacity }} className=\"relative z-10 text-center px-6\">\n        <motion.p \n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ delay: 0.5 }}\n          className=\"text-zinc-400 font-bold tracking-[0.4em] uppercase text-[10px] mb-6\"\n        >\n          Building India\'s Digital Backbone\n        </motion.p>\n        <motion.h1 \n          initial={{ opacity: 0, y: 30 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ delay: 0.7, duration: 0.8 }}\n          className=\"text-5xl md:text-8xl font-black text-white tracking-tighter mb-8 leading-[0.9]\"\n        >\n          ENGINEERING <br /> \n          <span className=\"italic font-serif text-zinc-300/50\">Tomorrow.</span>\n        </motion.h1>\n        <motion.div\n           initial={{ opacity: 0 }}\n           animate={{ opacity: 1 }}\n           transition={{ delay: 1.2 }}\n           className=\"flex flex-col items-center gap-8\"\n        >\n          <div className=\"h-20 w-[1px] bg-gradient-to-b from-zinc-500 to-transparent\" />\n          <motion.div \n            animate={{ y: [0, 10, 0] }}\n            transition={{ duration: 2, repeat: Infinity }}\n            className=\"text-zinc-500\"\n          >\n            <ChevronDown className=\"w-6 h-6\" />\n          </motion.div>\n        </motion.div>\n      </motion.div>\n    </section>\n  );\n};\n\nconst BrandsTicker = () => {\n  return (\n    <div className=\"py-16 bg-white border-y border-zinc-100 overflow-hidden whitespace-nowrap relative group\">\n      <div className=\"absolute left-0 top-0 w-32 h-full bg-gradient-to-r from-white to-transparent z-20 pointer-events-none\" />\n      <div className=\"absolute right-0 top-0 w-32 h-full bg-gradient-to-l from-white to-transparent z-20 pointer-events-none\" />\n      <motion.div \n        animate={{ x: [\"0%\", \"-50%\"] }}\n        transition={{ duration: 60, repeat: Infinity, ease: \"linear\" }}\n        className=\"inline-block\"\n      >\n        <div className=\"flex gap-24 items-center px-12\">\n          {[...BRANDS, ...BRANDS].map((brand, i) => (\n            <span key={i} className=\"text-zinc-300 text-sm font-bold tracking-[0.4em] uppercase hover:text-black transition-colors cursor-default whitespace-nowrap\">\n              {brand}\n            </span>\n          ))}\n        </div>\n      </motion.div>\n    </div>\n  );\n};\n\nconst QualitySection = () => {\n  const standards = [\n    { title: \'ISO 9001:2015\', desc: \'Quality Management Systems\' },\n    { title: \'ISO 45001:2018\', desc: \'Occupational Health & Safety\' },\n    { title: \'ISO 14001:2015\', desc: \'Environmental Management\' },\n    { title: \'IGBC Lead\', desc: \'Green Building Certifications\' },\n  ];\n\n  return (\n    <section className=\"py-12 bg-zinc-50 border-y border-zinc-100\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"flex flex-wrap justify-center md:justify-between items-center gap-12 grayscale opacity-40\">\n          {standards.map((s) => (\n            <div key={s.title} className=\"text-center group hover:opacity-100 transition-opacity\">\n              <p className=\"text-xs font-black tracking-widest uppercase text-zinc-900\">{s.title}</p>\n              <p className=\"text-[8px] font-bold text-zinc-500 uppercase tracking-tighter mt-1\">{s.desc}</p>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst StatsSection = () => {\n  return (\n    <section className=\"py-24 bg-white px-6\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-12 md:gap-20\">\n          {STATS.map((stat, idx) => (\n            <motion.div \n              key={stat.label}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              transition={{ delay: idx * 0.1 }}\n              viewport={{ once: true }}\n              className=\"text-center md:text-left\"\n            >\n              <p className=\"text-5xl md:text-7xl font-black text-zinc-900 tracking-tighter mb-2\">{stat.value}</p>\n              <div className=\"flex items-center gap-2 mb-2\">\n                <div className=\"w-8 h-[2px] bg-black\" />\n                <p className=\"text-[10px] font-black uppercase tracking-widest text-zinc-900\">{stat.label}</p>\n              </div>\n              <p className=\"text-zinc-400 text-xs font-medium leading-relaxed\">{stat.sub}</p>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};"
