ent-to-r from-slate-950 to-transparent z-10 pointer-events-none\" />\n      <div className=\"absolute right-0 top-0 w-48 h-full bg-gradient-to-l from-slate-950 to-transparent z-10 pointer-events-none\" />\n    </section>\n  );\n};"
