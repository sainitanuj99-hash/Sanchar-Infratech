ame=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n          </a>\n          <motion.div \n            animate={{ y: [0, 10, 0] }}\n            transition={{ repeat: Infinity, duration: 2 }}\n            className=\"text-white/30\"\n          >\n            <ChevronDown className=\"w-6 h-6\" />\n          </motion.div>\n        </motion.div>\n      </div>\n    </section>\n  );\n};\n"
