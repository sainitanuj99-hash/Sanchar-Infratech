le}</h4>\n                    <p className=\"text-slate-500 text-xs leading-relaxed max-w-sm\">{feature.desc}</p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </motion.div>\n\n          <div className=\"relative\">\n             <div className=\"aspect-video bg-slate-900 rounded-[40px] overflow-hidden border border-white/10 relative group shadow-2xl\">\n                <img \n                  src=\"https://images.unsplash.com/photo-1541888946425-d81bb19240f5?q=80&w=2070&auto=format&fit=crop\" \n                  alt=\"Live Site\"\n                  className=\"w-full h-full object-cover opacity-50 group-hover:scale-105 transition-transform duration-700\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 flex items-center justify-center\">\n                    <div className=\"w-20 h-20 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center border border-white/20 animate-pulse\">\n                      <div className=\"w-3 h-3 bg-red-600 rounded-full animate-ping\" />\n                    </div>\n                </div>\n                <div className=\"absolute top-6 left-6 flex items-center gap-2 bg-red-600/20 backdrop-blur-md px-3 py-1 rounded-full border border-red-600/50\">\n                  <span className=\"w-1.5 h-1.5 bg-red-600 rounded-full\" />\n                  <span className=\"text-[10px] text-red-500 font-bold uppercase tracking-widest\">Live: Site-047</span>\n                </div>\n             </div>\n             <div className=\"absolute -bottom-6 -left-6 bg-white p-6 rounded-3xl shadow-2xl border border-blue-50 hidden md:block\">\n                <div className=\"flex items-center gap-4\">\n                   <div className=\"w-10 h-10 rounded-full bg-blue-50 overflow-hidden border border-blue-100\">\n                     <img src=\"https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=2070&auto=format&fit=crop\" alt=\"Manager\" className=\"w-full h-full object-cover\" referrerPolicy=\"no-referrer\" />\n                   </div>\n                   <div>\n                     <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest\">On-Site Manager</p>\n                     <p className=\"text-sm font-bold text-slate-900\">Arjun Verma</p>\n                   </div>\n                </div>\n             </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};"
