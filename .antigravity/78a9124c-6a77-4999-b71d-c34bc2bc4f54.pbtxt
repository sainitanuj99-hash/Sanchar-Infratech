        target_content: "const TransparencySection = () => {\n  return (\n    <section className=\"py-24 bg-slate-950 px-6 overflow-hidden relative\">\n       {/* Background Accents */}\n      <div className=\"absolute top-0 right-0 w-1/3 h-full bg-blue-500/5 blur-[120px] rounded-full pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\">\n          <motion.div\n            initial={{ opacity: 0, x: -50 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true }}\n          >\n            <h2 className=\"text-blue-400/40 text-sm font-bold tracking-[0.3em] uppercase mb-6 flex items-center gap-3\">\n               <span className=\"w-12 h-[1px] bg-blue-500/20\" /> Radical Transparency\n            </h2>\n            <h3 className=\"text-4xl md:text-5xl font-bold text-white tracking-tight mb-8\">\n              Watch your vision <br />\n              <span className=\"italic font-light text-blue-200/50 font-serif text-6xl\">Take Shape Live.</span>\n            </h3>\n            <p className=\"text-slate-400 text-lg leading-relaxed mb-10 max-w-lg font-light\">\n              We eliminate the \"Black Box\" of construction. With Sanchar Infratech, you possess full visibility over every brick, beam, and finish.\n            </p>\n            \n            <div className=\"space-y-8\">\n              {TRANSPARENCY_FEATURES.map((feature, idx) => (\n                <div key={feature.title} className=\"flex gap-6 group\">\n                  <div className=\"flex-shrink-0 w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-white group-hover:bg-blue-600 group-hover:border-blue-600 transition-all\">\n                    <feature.icon size={24} />\n                  </div>\n                  <div>\n                    <h4 className=\"text-white font-bold mb-1 uppercase tracking-widest text-[10px]\">{feature.title}