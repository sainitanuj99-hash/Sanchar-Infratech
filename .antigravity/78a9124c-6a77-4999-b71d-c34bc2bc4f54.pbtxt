    replacement_infos {
      original_chunk {
        target_content: "        <motion.div \n          initial={{ opacity: 0, x: -20 }}\n          animate={{ opacity: 1, x: 0 }}\n          className={`text-2xl font-bold tracking-tighter ${isScrolled ? \'text-black\' : \'text-white\'}`}\n        >\n          SANCHAR.\n        </motion.div>\n\n        <div className=\"hidden md:flex space-x-8 items-center\">\n          {[\'About\', \'Sectors\', \'Projects\', \'Team\', \'Connect\'].map((item) => (\n            <a \n              key={item} \n              href={`#${item.toLowerCase()}`}\n              className={`text-sm font-medium tracking-widest uppercase transition-colors ${isScrolled ? \'text-zinc-600 hover:text-black\' : \'text-zinc-300 hover:text-white\'}`}\n            >\n              {item}\n            </a>\n          ))}\n          <button className={`px-5 py-2 rounded-full border text-xs font-bold tracking-widest uppercase transition-all ${isScrolled ? \'border-black text-black hover:bg-black hover:text-white\' : \'border-white text-white hover:bg-white hover:text-black\'}`}>\n            Gallery\n          </button>\n        </div>\n\n        <button \n          className=\"md:hidden\"\n          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n        >\n          {mobileMenuOpen ? <X className={isScrolled ? \'text-black\' : \'text-white\'} size={24} /> : <Menu className={isScrolled ? \'text-black\' : \'text-white\'} size={24} />}\n        </button>\n"
        replacement_content: "        <motion.div \n          initial={{ opacity: 0, x: -20 }}\n          animate={{ opacity: 1, x: 0 }}\n          className={`flex items-center gap-3 text-2xl font-black tracking-tighter ${isScrolled ? \'text-black\' : \'text-white\'}`}\n        >\n          <div className={`w-8 h-8 rounded-lg flex items-center justify-center ${isScrolled ? \'bg-black text-white\' : \'bg-white text-black\'}`}>\n             <Building2 size={18} />\n          </div>\n          SANCHAR.\n        </motion.div>\n\n        <div className=\"hidden md:flex space-x-10 items-center\">\n          {[\'About\', \'Sectors\', \'Projects\', \'Team\', \'Connect\'].map((item) => (\n            <a \n              key={item} \n              href={`#${item.toLowerCase()}`}\n              className={`text-[10px] font-bold tracking-[0.2em] uppercase transition-colors ${isScrolled ? \'text-zinc-600 hover:text-black\' : \'text-zinc-300 hover:text-white\'}`}\n            >\n              {item}\n            </a>\n          ))}\n          <button className={`px-6 py-2 rounded-full border text-[10px] font-black tracking-widest uppercase transition-all ${isScrolled ? \'border-black text-black hover:bg-black hover:text-white\' : \'border-white text-white hover:bg-white hover:text-black\'}`}>\n            Gallery\n          </button>\n        </div>\n\n        <button \n          className={`md:hidden w-10 h-10 rounded-full flex items-center justify-center transition-all ${isScrolled ? \'bg-black text-white\' : \'bg-white/10 backdrop-blur-md text-white\'}`}\n          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n        >\n          {mobileMenuOpen ? <X size={20} /> : <Menu size={20} />}\n        </button>\n"
      }
      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "const VastuSection = () => {\n  return (\n    <section id=\"consultancy\" className=\"py-24 bg-zinc-950 relative overflow-hidden\">\n      <div className=\"absolute top-0 right-0 w-1/2 h-full opacity-10\">\n        <Compass className=\"w-full h-full text-white rotate-12\" />\n      </div>\n      \n      <div className=\"max-w-7xl mx-auto px-6 relative z-10\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\n          <motion.div \n            initial={{ opacity: 0, x: -30 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true }}\n          >\n            <h2 className=\"text-white/40 text-sm font-bold tracking-[0.2em] uppercase mb-4\">Integrated Wisdom</h2>\n            <h3 className=\"text-4xl md:text-5xl font-bold text-white tracking-tight mb-8\">\n              Expert Vastu <br />\n              <span className=\"italic font-light text-white/50\">Consultancy Available</span>\n            </h3>\n            <p className=\"text-zinc-400 text-lg mb-8 leading-relaxed max-w-lg\">\n              We harmonize modern architecture with ancient wisdom. Our in-house Vastu experts ensure your spaces are not just structures, but conduits for positive energy and prosperity.\n            </p>\n            <div className=\"flex flex-wrap gap-4\">\n              {[\'Energy Mapping\', \'Spatial Alignment\', \'Harmonic Balance\', \'Modern Integration\'].map(tag => (\n                <span key={tag} className=\"border border-white/20 px-4 py-2 rounded-full text-xs text-white/60 font-medium\">\n                  {tag}\n                </span>\n              ))}\n            </div>\n          </motion.div>\n\n          <motion.div \n            initial={{ opacity: 0, scale: 0.9 }}\n            whileInView={{ opacity: 1, scale: 1 }}\n            viewport={{ once: true }}\n            className=\"aspect-square relative flex items-center justify-center p-12 bg-white/5 rounded-full border border-white/10\"\n          >\n            <div className=\"rounded-full border border-white/20 w-full h-full flex items-center justify-center animate-spin-slow\">\n              <Compass className=\"w-16 h-16 text-white\" />\n            </div>\n            <div className=\"absolute inset-0 flex items-center justify-center\">\n               <div className=\"w-1/2 h-1/2 bg-white/20 blur-3xl rounded-full\" />\n            </div>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
        replacement_content: "const VastuSection = () => {\n  return (\n    <section id=\"consultancy\" className=\"py-24 bg-zinc-950 relative overflow-hidden\">\n      <div className=\"absolute -top-24 -left-20 w-1/2 h-full opacity-[0.03] pointer-events-none\">\n        <Compass className=\"w-full h-full text-white -rotate-12\" />\n      </div>\n      \n      <div className=\"max-w-7xl mx-auto px-6 relative z-10\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\">\n          <motion.div \n            initial={{ opacity: 0, x: -30 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true }}\n          >\n            <h2 className=\"text-white/40 text-sm font-bold tracking-[0.3em] uppercase mb-6 flex items-center gap-3\">\n               <span className=\"w-12 h-[1px] bg-white/20\" /> Cosmic Alignment\n            </h2>\n            <h3 className=\"text-4xl md:text-6xl font-black text-white tracking-tighter mb-8 font-sans\">\n              Expert Vastu <br />\n              <span className=\"italic font-serif text-white/40 text-7xl md:text-8xl\">Consultancy.</span>\n            </h3>\n            <p className=\"text-zinc-400 text-xl mb-10 leading-relaxed max-w-lg font-light\">\n              We harmonize modern architectural precision with ancient spatial wisdom. Our dedicated Vedic consultants ensure every square inch radiates prosperity and equilibrium.\n            </p>\n            <div className=\"grid grid-cols-2 gap-6\">\n              {[\n                { t: \'Energy Mapping\', d: \'Strategic flow analysis.\' },\n                { t: \'Spatial Balance\', d: \'Optimized orientation.\' }\n              ].map(item => (\n                <div key={item.t} className=\"p-6 bg-white/5 border border-white/10 rounded-2xl\">\n                  <p className=\"text-white font-bold text-xs uppercase tracking-widest mb-2\">{item.t}</p>\n                  <p className=\"text-white/40 text-[10px] leading-tight\">{item.d}</p>\n                </div>\n              ))}\n            </div>\n          </motion.div>\n\n          <motion.div \n            initial={{ opacity: 0, scale: 0.8 }}\n            whileInView={{ opacity: 1, scale: 1 }}\n            viewport={{ once: true }}\n            className=\"relative flex items-center justify-center p-20\"\n          >\n            <div className=\"absolute inset-0 flex items-center justify-center\">\n               <div className=\"w-[80%] h-[80%] bg-blue-500/10 blur-[120px] rounded-full animate-pulse\" />\n            </div>\n            \n            <div className=\"relative w-full aspect-square max-w-[400px] border border-white/10 rounded-full flex items-center justify-center\">\n               <div className=\"absolute inset-4 border border-white/5 rounded-full\" />\n               <div className=\"absolute inset-12 border border-white/5 rounded-full\" />\n               \n               <motion.div \n                 animate={{ rotate: 360 }}\n                 transition={{ duration: 30, repeat: Infinity, ease: \"linear\" }}\n                 className=\"absolute inset-0 flex items-start justify-center p-4\"\n               >\n                 <div className=\"w-1 h-1 bg-white rounded-full shadow-[0_0_10px_white]\" />\n               </motion.div>\n\n               <Compass className=\"w-24 h-24 text-white opacity-90 drop-shadow-[0_0_20px_rgba(255,255,255,0.2)]\" />\n            </div>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
