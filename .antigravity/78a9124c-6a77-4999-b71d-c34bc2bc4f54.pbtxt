    replacement_infos {
      original_chunk {
        target_content: "const ValuesSection = () => {\n  return (\n    <section className=\"py-24 bg-white px-6\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-20\">\n          <div>\n             <h2 className=\"text-sm font-bold tracking-[0.2em] uppercase text-zinc-400 mb-4\">Differentiators</h2>\n             <h3 className=\"text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 mb-8 font-sans\">\n              Why Leaders Choose <br /> <span className=\"text-zinc-300 italic font-serif\">Sanchar Infratech.</span>\n            </h3>\n            <p className=\"text-zinc-500 text-lg leading-relaxed mb-10 max-w-lg\">\n              Our commitment to quality and safety is backed by decades of experience and a relentless drive for innovation.\n            </p>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-8\">\n              {VALUES.map((value, idx) => (\n                <div key={value.title} className=\"space-y-3\">\n                  <div className=\"w-10 h-10 rounded-full bg-zinc-100 flex items-center justify-center\">\n                    <value.icon size={18} />\n                  </div>\n                  <h4 className=\"font-bold text-zinc-900 uppercase tracking-widest text-[10px]\">{value.title}</h4>\n                  <p className=\"text-zinc-500 text-xs leading-relaxed\">{value.desc}</p>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-4 translate-y-12\">\n               <div className=\"aspect-[4/5] rounded-[40px] overflow-hidden\">\n                <img src=\"https://images.unsplash.com/photo-1541888946425-d81bb19240f5?q=80&w=2070&auto=format&fit=crop\" className=\"w-full h-full object-cover\" alt=\"Construction\" referrerPolicy=\"no-referrer\" />\n               </div>\n               <div className=\"aspect-square rounded-[40px] overflow-hidden\">\n                <img src=\"https://images.unsplash.com/photo-1531834351307-e83c74624775?q=80&w=1974&auto=format&fit=crop\" className=\"w-full h-full object-cover\" alt=\"Construction\" referrerPolicy=\"no-referrer\" />\n               </div>\n            </div>\n            <div className=\"space-y-4\">\n               <div className=\"aspect-square rounded-[40px] overflow-hidden\">\n                <img src=\"https://images.unsplash.com/photo-1517581177682-a085bb7ffb15?q=80&w=2072&auto=format&fit=crop\" className=\"w-full h-full object-cover\" alt=\"Construction\" referrerPolicy=\"no-referrer\" />\n               </div>\n               <div className=\"aspect-[4/5] rounded-[40px] overflow-hidden\">\n                <img src=\"https://images.unsplash.com/photo-1581092160562-40aa08e78837?q=80&w=2070&auto=format&fit=crop\" className=\"w-full h-full object-cover\" alt=\"Construction\" referrerPolicy=\"no-referrer\" />\n               </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};"
        replacement_content: "const ValuesSection = () => {\n  return (\n    <section className=\"py-24 bg-white px-6\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"text-center mb-16\">\n          <h2 className=\"text-sm font-bold tracking-[0.2em] uppercase text-zinc-400 mb-4\">Differentiators</h2>\n          <h3 className=\"text-4xl md:text-6xl font-bold tracking-tight text-zinc-900 font-sans\">\n            Why Leaders Choose <br /> <span className=\"text-zinc-300 italic font-serif\">Sanchar Infratech.</span>\n          </h3>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-4 grid-rows-2 gap-4 h-auto md:h-[800px]\">\n          {/* Large Featured Card */}\n          <motion.div \n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            className=\"md:col-span-2 md:row-span-2 bg-zinc-950 rounded-[40px] p-12 text-white flex flex-col justify-between overflow-hidden relative group\"\n          >\n            <div className=\"relative z-10\">\n              <Zap className=\"w-12 h-12 mb-8 text-white/50\" />\n              <h4 className=\"text-3xl font-bold mb-4\">Innovation First</h4>\n              <p className=\"text-zinc-400 text-lg leading-relaxed max-w-sm\">\n                Integrating cutting-edge technology and materials in every build to ensure longevity and efficiency.\n              </p>\n            </div>\n            <div className=\"absolute inset-0 opacity-20 transition-transform duration-700 group-hover:scale-110\">\n               <img src=\"https://images.unsplash.com/photo-1541888946425-d81bb19240f5?q=80&w=2070&auto=format&fit=crop\" alt=\"Innovation\" className=\"w-full h-full object-cover\" />\n            </div>\n            <div className=\"relative z-10 pt-12\">\n               <div className=\"flex gap-2\">\n                 <span className=\"px-3 py-1 bg-white/10 rounded-full text-[10px] font-bold uppercase tracking-widest border border-white/10\">BIM Modeling</span>\n                 <span className=\"px-3 py-1 bg-white/10 rounded-full text-[10px] font-bold uppercase tracking-widest border border-white/10\">Smart Infrastructure</span>\n               </div>\n            </div>\n          </motion.div>\n\n          {/* Medium Secondary Cards */}\n          <motion.div \n            initial={{ opacity: 0, x: 20 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true }}\n            className=\"md:col-span-2 bg-zinc-50 rounded-[40px] p-10 border border-zinc-100 flex flex-col justify-center\"\n          >\n            <div className=\"flex items-center gap-6 mb-6\">\n              <div className=\"w-14 h-14 bg-black text-white rounded-2xl flex items-center justify-center\">\n                <ShieldCheck size={28} />\n              </div>\n              <h4 className=\"text-2xl font-bold tracking-tight\">Zero-Compromise Safety</h4>\n            </div>\n            <p className=\"text-zinc-500 leading-relaxed\">\n              Our safety protocols exceed international standards, ensuring every operative on-site works in a fortress of compliance and security.\n            </p>\n          </motion.div>\n\n          <motion.div \n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            className=\"bg-zinc-100 rounded-[40px] p-8 flex flex-col justify-end group cursor-pointer overflow-hidden relative\"\n          >\n            <Globe className=\"w-8 h-8 mb-4 text-zinc-900 z-10\" />\n            <h4 className=\"text-xl font-bold text-zinc-900 z-10\">Sustainability</h4>\n            <div className=\"absolute inset-0 bg-black opacity-0 group-hover:opacity-90 transition-all duration-500 flex items-center p-8 z-20\">\n               <p className=\"text-white text-xs leading-relaxed\">Eco-conscious designs that minimize environmental footprint through carbon-neutral construction methods.</p>\n            </div>\n          </motion.div>\n\n          <motion.div \n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            className=\"bg-zinc-900 text-white rounded-[40px] p-8 flex flex-col justify-end relative overflow-hidden\"\n          >\n             <Users className=\"w-8 h-8 mb-4 opacity-50\" />\n             <h4 className=\"text-xl font-bold\">Client Centricity</h4>\n             <div className=\"absolute top-0 right-0 p-4 opacity-10\">\n                <Target size={120} />\n             </div>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
